    "test:browsers": "playwright test",
    "test:production": "node scripts/test-production.mjs",
    "benchmark": "node scripts/run-benchmark.mjs"
  },
  "dependencies": {
    "@fontsource/heebo": "^5.3.0",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@pdf-lib/upng": "^1.0.1",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "gifsicle-wasm-browser": "1.5.19",
    "gifuct-js": "^2.1.2",
    "lucide-react": "^1.59.0",
    "mupdf": "1.28.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/pngjs": "^6.0.5",
